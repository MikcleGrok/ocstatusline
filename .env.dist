# Toolchain image name. This fork ships per-platform binaries, not images, so the
# image never leaves the developer's machine or the CI runner.
IMAGE_NAME=ocstatusline-toolchain

# Pinned Bun version used for documentation and release identification.
BUN_VERSION=1.3.14

# Immutable multi-architecture Docker reference for the toolchain base.
# Update BUN_VERSION and this digest together after checking the upstream
# manifest; the content tag changes so `make image` rebuilds automatically.
BUN_BASE_IMAGE_REF=oven/bun@sha256:9dba1a1b43ce28c9d7931bfc4eb00feb63b0114720a0277a8f939ae4dfc9db6f

# Host port mock-opencode is published on locally. The container port is always 4096.
MOCK_PORT=4096

# Terminal width pinned for every render/golden test and every smoke run, so the
# output can never flake with the developer's terminal size.
TEST_COLUMNS=120

# Runtime that executes the vitest suite inside the toolchain image: bun | node.
TEST_RUNTIME=bun
