{
  "name": "ocstatusline-bun",
  "version": "0.1.0",
  "description": "Highly customizable live status line for OpenCode, built as a single self-contained binary (fork of amirlehmam/ocstatusline)",
  "type": "module",
  "bin": {
    "ocstatusline": "src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mock": "bun run tests/mock/mock-opencode.ts"
  },
  "keywords": [
    "opencode",
    "statusline",
    "status-line",
    "ccstatusline",
    "tui",
    "ink",
    "cli",
    "powerline",
    "terminal",
    "bun",
    "single-binary"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/USER/ocstatusline.git"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.2.6",
    "ink": "^7.0.5",
    "react": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.2.15",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
  },
  "license": "MIT"
}